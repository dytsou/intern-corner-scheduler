{
  "name": "@dytsou/intern-corner-scheduler",
  "version": "1.3.2",
  "type": "module",
  "description": "Round-table Scheduler (CP-SAT) - Python CLI and web interface using OR-Tools CP-SAT to generate round-table seating across rounds with fixed hosts, balanced tables, and pair-wise constraints",
  "author": "dytsou",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dytsou/intern-corner-scheduler.git"
  },
  "keywords": [
    "scheduler",
    "round-table",
    "cp-sat",
    "or-tools",
    "seating",
    "optimization"
  ],
  "files": [
    "src",
    "scripts",
    "index.html",
    "vite.config.js",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/create-nojekyll.js",
    "build:cloudflare": "pnpm install --frozen-lockfile && pnpm build",
    "preview": "vite preview",
    "deploy:preview": "pnpm build && pnpm dlx wrangler pages deploy ./docs --branch preview",
    "deploy:production": "pnpm build && pnpm dlx wrangler pages deploy ./docs --branch main",
    "test": "node --test tests/web-scheduler.test.js",
    "test:browser": "playwright test",
    "lint": "eslint . --ext js,jsx --ignore-pattern 'docs/**' --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css}\" \"scripts/**/*.js\" \"*.{js,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css}\" \"scripts/**/*.js\" \"*.{js,json,html}\"",
    "publish:npmjs": "npm publish --access public --registry https://registry.npmjs.org"
  },
  "dependencies": {
    "or-tools-wasm": "0.9.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.13.0",
    "prettier": "^3.7.4",
    "protobufjs": "8.8.0",
    "vite": "^8.2.1"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "brace-expansion@1": "1.1.18",
      "baseline-browser-mapping": "2.11.0",
      "browserslist": "4.28.7",
      "js-yaml": "4.3.2"
    },
    "patchedDependencies": {
      "or-tools-wasm@0.9.1": "patches/or-tools-wasm@0.9.1.patch"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
